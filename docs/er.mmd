erDiagram
    direction TB
    FLIGHTS ||--o{ SEAT_RESERVATIONS : flight_id
    FLIGHTS ||--o{ BOOKINGS : "flight_id, no FK"
    BOOKINGS ||--|| SEAT_RESERVATIONS : "booking_id, no FK"

    FLIGHTS {
        uuid id PK
        varchar flight_number
        char origin_iata
        char destination_iata
        date departure_date
        timestamptz departure_at
        timestamptz arrival_at
        int total_seats
        int available_seats
        numeric price
        enum status
        timestamptz created_at
        timestamptz updated_at
    }

    SEAT_RESERVATIONS {
        uuid id PK
        uuid flight_id FK
        uuid booking_id UK
        int seat_count
        enum status
        timestamptz created_at
        timestamptz updated_at
    }

    BOOKINGS {
        uuid id PK
        uuid user_id
        uuid flight_id
        varchar passenger_name
        varchar passenger_email
        int seat_count
        numeric total_price
        enum status
        timestamptz created_at
        timestamptz updated_at
    }
